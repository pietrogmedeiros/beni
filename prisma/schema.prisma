// Beni — gestão de projetos, tarefas e backlog
// Hierarquia: Workspace > Project > (Sprint | Status) > Task > Subtask

generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

enum WorkspaceRole {
  OWNER
  ADMIN
  MEMBER
  GUEST
}

enum StatusCategory {
  BACKLOG
  TODO
  IN_PROGRESS
  DONE
  CANCELED
}

enum Priority {
  NONE
  LOW
  MEDIUM
  HIGH
  URGENT
}

enum TaskType {
  TASK
  BUG
  STORY
  EPIC
  CHORE
}

enum SprintStatus {
  PLANNED
  ACTIVE
  COMPLETED
}

enum ChannelKind {
  PUBLIC
  PRIVATE
  DIRECT
}

enum GithubLinkType {
  ISSUE
  PULL_REQUEST
}

enum ApprovalStatus {
  PENDING
  APPROVED
  REJECTED
}

enum DependencyType {
  FINISH_TO_START
  START_TO_START
  FINISH_TO_FINISH
  START_TO_FINISH
}

model User {
  id           String   @id @default(cuid())
  email        String   @unique
  name         String
  passwordHash String
  avatarColor  String   @default("#eab308")
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  memberships   Membership[]
  assignedTasks Task[]       @relation("TaskAssignee")
  reportedTasks Task[]       @relation("TaskReporter")
  comments      Comment[]
  activities    Activity[]
  approvals     Approval[]     @relation("ApprovalRequester")
  attachments   Attachment[]   @relation("AttachmentUploader")
  apiTokens     ApiToken[]
  shares        ProjectShare[] @relation("ShareCreator")
  channels      ChannelMember[]
  messages      Message[]
  reactions     Reaction[]
  mentions      Mention[]
}

model Workspace {
  id        String   @id @default(cuid())
  name      String
  slug      String   @unique
  createdAt DateTime @default(now())

  /// Token do GitHub (PAT) guardado cifrado — usado para repositórios privados
  githubToken String?

  members   Membership[]
  projects  Project[]
  apiTokens ApiToken[]
  tags     Tag[]
  channels Channel[]
}

model Membership {
  id          String        @id @default(cuid())
  userId      String
  workspaceId String
  role        WorkspaceRole @default(MEMBER)
  createdAt   DateTime      @default(now())

  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  workspace Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)

  @@unique([userId, workspaceId])
}

model Project {
  id          String    @id @default(cuid())
  workspaceId String
  name        String
  key         String
  description String?
  color       String    @default("#eab308")
  icon        String    @default("Rocket")
  archived    Boolean   @default(false)
  order       Float     @default(0)
  taskCounter Int       @default(0)
  startDate   DateTime?
  endDate     DateTime?
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  workspace    Workspace    @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  statuses     TaskStatus[]
  sprints      Sprint[]
  tasks        Task[]
  activities   Activity[]
  repositories GithubRepo[]
  shares       ProjectShare[]

  @@unique([workspaceId, key])
}

model TaskStatus {
  id        String         @id @default(cuid())
  projectId String
  name      String
  color     String         @default("#94a3b8")
  category  StatusCategory @default(TODO)
  order     Float          @default(0)

  project Project @relation(fields: [projectId], references: [id], onDelete: Cascade)
  tasks   Task[]

  @@index([projectId])
}

model Sprint {
  id        String       @id @default(cuid())
  projectId String
  name      String
  goal      String?
  status    SprintStatus @default(PLANNED)
  startDate DateTime?
  endDate   DateTime?
  order     Float        @default(0)
  createdAt DateTime     @default(now())

  project Project @relation(fields: [projectId], references: [id], onDelete: Cascade)
  tasks   Task[]

  @@index([projectId])
}

model Task {
  id          String    @id @default(cuid())
  projectId   String
  number      Int
  title       String
  description String?
  statusId    String
  sprintId    String?
  parentId    String?
  type        TaskType  @default(TASK)
  priority    Priority  @default(NONE)
  assigneeId  String?
  reporterId  String?
  startDate   DateTime?
  dueDate     DateTime?
  estimate    Float?
  points      Int?
  progress    Int       @default(0)
  order       Float     @default(0)
  archived    Boolean   @default(false)
  completedAt DateTime?
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  project    Project      @relation(fields: [projectId], references: [id], onDelete: Cascade)
  status     TaskStatus   @relation(fields: [statusId], references: [id])
  sprint     Sprint?      @relation(fields: [sprintId], references: [id], onDelete: SetNull)
  parent     Task?        @relation("Subtasks", fields: [parentId], references: [id], onDelete: Cascade)
  subtasks   Task[]       @relation("Subtasks")
  assignee   User?        @relation("TaskAssignee", fields: [assigneeId], references: [id], onDelete: SetNull)
  reporter   User?        @relation("TaskReporter", fields: [reporterId], references: [id], onDelete: SetNull)
  tags       TaskTag[]
  comments   Comment[]
  activities Activity[]
  blockedBy   Dependency[]     @relation("DependencyTask")
  blocking    Dependency[]     @relation("DependencyBlocker")
  approvals   Approval[]
  attachments Attachment[]
  githubLinks TaskGithubLink[]

  @@unique([projectId, number])
  @@index([projectId, statusId])
  @@index([sprintId])
  @@index([assigneeId])
}

/// Canal de conversa do workspace: público, privado ou mensagem direta.
model Channel {
  id          String      @id @default(cuid())
  workspaceId String
  kind        ChannelKind @default(PUBLIC)
  name        String?
  topic       String?
  /// Projeto opcional ao qual o canal está ligado
  projectId   String?
  createdById String?
  archived    Boolean     @default(false)
  createdAt   DateTime    @default(now())
  updatedAt   DateTime    @updatedAt

  workspace Workspace       @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  members   ChannelMember[]
  messages  Message[]

  @@index([workspaceId])
}

model ChannelMember {
  id         String    @id @default(cuid())
  channelId  String
  userId     String
  isAdmin    Boolean   @default(false)
  lastReadAt DateTime  @default(now())
  mutedAt    DateTime?
  joinedAt   DateTime  @default(now())

  channel Channel @relation(fields: [channelId], references: [id], onDelete: Cascade)
  user    User    @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([channelId, userId])
  @@index([userId])
}

model Message {
  id        String    @id @default(cuid())
  channelId String
  authorId  String
  body      String
  /// Mensagem raiz quando esta é uma resposta em thread
  parentId  String?
  /// Tarefa citada na mensagem (opcional)
  taskId    String?
  editedAt  DateTime?
  createdAt DateTime  @default(now())

  channel  Channel    @relation(fields: [channelId], references: [id], onDelete: Cascade)
  author   User       @relation(fields: [authorId], references: [id], onDelete: Cascade)
  parent   Message?   @relation("Thread", fields: [parentId], references: [id], onDelete: Cascade)
  replies  Message[]  @relation("Thread")
  reactions Reaction[]
  mentions Mention[]

  @@index([channelId, createdAt])
  @@index([parentId])
}

model Reaction {
  id        String   @id @default(cuid())
  messageId String
  userId    String
  emoji     String
  createdAt DateTime @default(now())

  message Message @relation(fields: [messageId], references: [id], onDelete: Cascade)
  user    User    @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([messageId, userId, emoji])
}

model Mention {
  id        String   @id @default(cuid())
  messageId String
  userId    String
  readAt    DateTime?
  createdAt DateTime @default(now())

  message Message @relation(fields: [messageId], references: [id], onDelete: Cascade)
  user    User    @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([messageId, userId])
  @@index([userId, readAt])
}

model Tag {
  id          String @id @default(cuid())
  workspaceId String
  name        String
  color       String @default("#eab308")

  workspace Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  tasks     TaskTag[]

  @@unique([workspaceId, name])
}

model TaskTag {
  taskId String
  tagId  String

  task Task @relation(fields: [taskId], references: [id], onDelete: Cascade)
  tag  Tag  @relation(fields: [tagId], references: [id], onDelete: Cascade)

  @@id([taskId, tagId])
}

model Dependency {
  id          String         @id @default(cuid())
  taskId      String
  dependsOnId String
  type        DependencyType @default(FINISH_TO_START)

  task      Task @relation("DependencyTask", fields: [taskId], references: [id], onDelete: Cascade)
  dependsOn Task @relation("DependencyBlocker", fields: [dependsOnId], references: [id], onDelete: Cascade)

  @@unique([taskId, dependsOnId])
}

/// Repositório do GitHub vinculado a um projeto.
model GithubRepo {
  id            String   @id @default(cuid())
  projectId     String
  owner         String
  name          String
  htmlUrl       String
  description   String?
  defaultBranch String   @default("main")
  isPrivate     Boolean  @default(false)
  createdAt     DateTime @default(now())

  project Project          @relation(fields: [projectId], references: [id], onDelete: Cascade)
  links   TaskGithubLink[]

  @@unique([projectId, owner, name])
}

/// Issue ou pull request do GitHub vinculada a uma tarefa.
model TaskGithubLink {
  id       String         @id @default(cuid())
  taskId   String
  repoId   String
  type     GithubLinkType
  number   Int
  title    String
  state    String
  htmlUrl  String
  author   String?
  syncedAt DateTime       @default(now())

  task Task       @relation(fields: [taskId], references: [id], onDelete: Cascade)
  repo GithubRepo @relation(fields: [repoId], references: [id], onDelete: Cascade)

  @@unique([taskId, repoId, number])
  @@index([taskId])
}

/// Pedido de aprovação enviado a um stakeholder por link público.
/// O aprovador não precisa de conta: identifica-se pelo nome ao decidir.
/// Chave de acesso à API do Beni — é o que permite ao MCP (e a qualquer
/// integração) agir em nome de uma pessoa sem usar a senha dela.
///
/// Guardamos só o hash: o valor completo aparece uma única vez, na criação.
/// Se vazar do lado de lá, revoga-se aqui sem trocar senha nenhuma.
model ApiToken {
  id          String    @id @default(cuid())
  workspaceId String
  userId      String
  name        String
  tokenHash   String    @unique
  /// Últimos 4 caracteres, só para a pessoa reconhecer qual é qual na lista.
  hint        String
  lastUsedAt  DateTime?
  revokedAt   DateTime?
  createdAt   DateTime  @default(now())

  workspace Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([workspaceId])
}

/// Arquivo anexado a uma tarefa.
///
/// Por padrão o conteúdo fica aqui mesmo, em `data`: assim o anexo sobrevive a
/// qualquer implantação sem depender de volume montado na plataforma. Para
/// arquivos realmente grandes, definir `UPLOAD_DIR` passa a gravar em disco e
/// só o `storageKey` fica no banco.
model Attachment {
  id           String   @id @default(cuid())
  taskId       String
  name         String
  mimeType     String
  size         Int
  /// Conteúdo do arquivo. É o padrão: funciona sem configurar volume nenhum.
  data         Bytes?
  /// Nome em disco, quando UPLOAD_DIR está definido (arquivos grandes).
  storageKey   String?  @unique
  uploadedById String?
  createdAt    DateTime @default(now())

  task       Task  @relation(fields: [taskId], references: [id], onDelete: Cascade)
  uploadedBy User? @relation("AttachmentUploader", fields: [uploadedById], references: [id], onDelete: SetNull)

  @@index([taskId])
}

model Approval {
  id              String         @id @default(cuid())
  taskId          String
  token           String         @unique
  requestedById   String?
  message         String?
  status          ApprovalStatus @default(PENDING)
  approverName    String?
  approverEmail   String?
  approverComment String?
  decidedAt       DateTime?
  expiresAt       DateTime?
  createdAt       DateTime       @default(now())

  task        Task  @relation(fields: [taskId], references: [id], onDelete: Cascade)
  requestedBy User? @relation("ApprovalRequester", fields: [requestedById], references: [id], onDelete: SetNull)

  @@index([taskId])
}

model Comment {
  id       String  @id @default(cuid())
  taskId   String
  authorId String?
  /// Preenchidos quando o comentário vem de um link público (visitante sem conta)
  guestName  String?
  guestEmail String?
  body       String

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  task   Task  @relation(fields: [taskId], references: [id], onDelete: Cascade)
  author User? @relation(fields: [authorId], references: [id], onDelete: Cascade)

  @@index([taskId])
}

/// Link público de leitura de uma visão do projeto (hoje: o Gantt).
/// Quem tem o link pode ver e, se permitido, comentar nas tarefas.
model ProjectShare {
  id            String    @id @default(cuid())
  projectId     String
  token         String    @unique
  view          String    @default("gantt")
  allowComments Boolean   @default(true)
  createdById   String?
  expiresAt     DateTime?
  createdAt     DateTime  @default(now())

  project   Project @relation(fields: [projectId], references: [id], onDelete: Cascade)
  createdBy User?   @relation("ShareCreator", fields: [createdById], references: [id], onDelete: SetNull)

  @@index([projectId])
}

model Activity {
  id        String   @id @default(cuid())
  projectId String
  taskId    String?
  userId    String?
  action    String
  meta      Json?
  createdAt DateTime @default(now())

  project Project @relation(fields: [projectId], references: [id], onDelete: Cascade)
  task    Task?    @relation(fields: [taskId], references: [id], onDelete: Cascade)
  user    User?    @relation(fields: [userId], references: [id], onDelete: SetNull)

  @@index([projectId, createdAt])
  @@index([taskId])
}
