// Beni — gestão de projetos, tarefas e backlog
// Hierarquia: Workspace > Project > (Sprint | Status) > Task > Subtask

generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

enum WorkspaceRole {
  OWNER
  ADMIN
  MEMBER
  GUEST
}

enum StatusCategory {
  BACKLOG
  TODO
  IN_PROGRESS
  DONE
  CANCELED
}

enum Priority {
  NONE
  LOW
  MEDIUM
  HIGH
  URGENT
}

enum TaskType {
  TASK
  BUG
  STORY
  EPIC
  CHORE
}

enum SprintStatus {
  PLANNED
  ACTIVE
  COMPLETED
}

enum ChannelKind {
  PUBLIC
  PRIVATE
  DIRECT
}

enum GithubLinkType {
  ISSUE
  PULL_REQUEST
}

enum ApprovalStatus {
  PENDING
  APPROVED
  REJECTED
}

enum TokenPurpose {
  RESET_SENHA
  CONFIRMAR_EMAIL
}

enum FeedbackKind {
  PROBLEMA
  IDEIA
  ELOGIO
  DUVIDA
}

enum FeedbackStatus {
  NOVO
  TRIADO
  PLANEJADO
  FAZENDO
  FEITO
  RECUSADO
}

enum DependencyType {
  FINISH_TO_START
  START_TO_START
  FINISH_TO_FINISH
  START_TO_FINISH
}

/// Como o dinheiro chega. Só três formas, porque só existem três de verdade:
/// um valor fechado dividido, uma mensalidade que se repete, ou um pagamento
/// único.
enum CobrancaTipo {
  PARCELADO
  MENSAL
  AVULSO
}

/// Situação de uma parcela.
///
/// Não existe ATRASADO aqui de propósito: atraso é `PENDENTE` com vencimento
/// no passado, e isso se calcula na hora de ler. Guardar como estado exigiria
/// alguém virando a chave todo dia à meia-noite — mais uma rotina para falhar
/// e uma tabela que mente quando ela falha.
enum ParcelaStatus {
  PENDENTE
  PAGO
  CANCELADO
}

model User {
  id           String   @id @default(cuid())
  email        String   @unique
  name         String
  passwordHash String
  avatarColor  String   @default("#eab308")
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  memberships       Membership[]
  assignedTasks     Task[]             @relation("TaskAssignee")
  reportedTasks     Task[]             @relation("TaskReporter")
  comments          Comment[]
  activities        Activity[]
  approvals         Approval[]         @relation("ApprovalRequester")
  attachments       Attachment[]       @relation("AttachmentUploader")
  notes             Note[]
  notificationsRead NotificationRead[]
  emailsSent        EmailLog[]

  /// Avisos por e-mail. Quem não quiser, desliga em Configurações.
  emailOnAssign    Boolean @default(true)
  emailOnApproval  Boolean @default(true)
  emailDailyDigest Boolean @default(true)

  /// Quando o dono do endereço provou que é ele. Nulo = ainda não confirmou.
  emailVerifiedAt DateTime?

  /// Mascote escolhido como avatar (nome da cor). Nulo = foto, se houver, ou
  /// as iniciais. Foto e mascote são excludentes de propósito: dois avatares
  /// guardados e só um valendo vira estado escondido.
  avatarMascot String?
  avatarFoto   Avatar?
  /// Muda a cada redefinição de senha e derruba as sessões antigas. Sem isto,
  /// trocar a senha não expulsa quem já estava dentro — que é justamente o
  /// motivo de alguém trocar a senha às pressas.
  sessionEpoch Int         @default(0)
  authTokens   AuthToken[]

  feedbacks          Feedback[]      @relation("FeedbackAuthor")
  /// Quando o convite para dar feedback foi mostrado. Preenchido tanto ao
  /// enviar quanto ao dispensar: o convite é único e não volta.
  feedbackPromptedAt DateTime?
  apiTokens          ApiToken[]
  oauthCodes         OAuthCode[]
  shares             ProjectShare[]  @relation("ShareCreator")
  channels           ChannelMember[]
  messages           Message[]
  reactions          Reaction[]
  mentions           Mention[]

  /// Carteira de cobranças. É por dono, não por workspace: o que se cobra de
  /// um cliente não é assunto do time que trabalha no projeto dele.
  clientes  Cliente[]
  cobrancas Cobranca[]
}

model Workspace {
  id        String   @id @default(cuid())
  name      String
  slug      String   @unique
  createdAt DateTime @default(now())

  /// Token do GitHub (PAT) guardado cifrado — usado para repositórios privados
  githubToken String?

  members   Membership[]
  projects  Project[]
  apiTokens ApiToken[]
  tags      Tag[]
  channels  Channel[]
}

model Membership {
  id          String        @id @default(cuid())
  userId      String
  workspaceId String
  role        WorkspaceRole @default(MEMBER)
  createdAt   DateTime      @default(now())

  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  workspace Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)

  @@unique([userId, workspaceId])
}

model Project {
  id          String    @id @default(cuid())
  workspaceId String
  name        String
  key         String
  description String?
  color       String    @default("#eab308")
  icon        String    @default("Rocket")
  archived    Boolean   @default(false)
  order       Float     @default(0)
  taskCounter Int       @default(0)
  startDate   DateTime?
  endDate     DateTime?
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  workspace    Workspace      @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  statuses     TaskStatus[]
  sprints      Sprint[]
  tasks        Task[]
  notes        Note[]
  activities   Activity[]
  repositories GithubRepo[]
  shares       ProjectShare[]
  cobrancas    Cobranca[]

  @@unique([workspaceId, key])
}

model TaskStatus {
  id        String         @id @default(cuid())
  projectId String
  name      String
  color     String         @default("#94a3b8")
  category  StatusCategory @default(TODO)
  order     Float          @default(0)

  project Project @relation(fields: [projectId], references: [id], onDelete: Cascade)
  tasks   Task[]

  @@index([projectId])
}

model Sprint {
  id        String       @id @default(cuid())
  projectId String
  name      String
  goal      String?
  status    SprintStatus @default(PLANNED)
  startDate DateTime?
  endDate   DateTime?
  order     Float        @default(0)
  createdAt DateTime     @default(now())

  project Project @relation(fields: [projectId], references: [id], onDelete: Cascade)
  tasks   Task[]

  @@index([projectId])
}

model Task {
  id          String    @id @default(cuid())
  projectId   String
  number      Int
  title       String
  description String?
  statusId    String
  sprintId    String?
  parentId    String?
  type        TaskType  @default(TASK)
  priority    Priority  @default(NONE)
  assigneeId  String?
  reporterId  String?
  startDate   DateTime?
  dueDate     DateTime?
  estimate    Float?
  points      Int?
  progress    Int       @default(0)
  order       Float     @default(0)
  archived    Boolean   @default(false)
  completedAt DateTime?
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  project     Project          @relation(fields: [projectId], references: [id], onDelete: Cascade)
  status      TaskStatus       @relation(fields: [statusId], references: [id])
  sprint      Sprint?          @relation(fields: [sprintId], references: [id], onDelete: SetNull)
  parent      Task?            @relation("Subtasks", fields: [parentId], references: [id], onDelete: Cascade)
  subtasks    Task[]           @relation("Subtasks")
  assignee    User?            @relation("TaskAssignee", fields: [assigneeId], references: [id], onDelete: SetNull)
  reporter    User?            @relation("TaskReporter", fields: [reporterId], references: [id], onDelete: SetNull)
  tags        TaskTag[]
  comments    Comment[]
  activities  Activity[]
  blockedBy   Dependency[]     @relation("DependencyTask")
  blocking    Dependency[]     @relation("DependencyBlocker")
  approvals   Approval[]
  attachments Attachment[]
  githubLinks TaskGithubLink[]
  feedbacks   Feedback[]       @relation("FeedbackTask")

  @@unique([projectId, number])
  @@index([projectId, statusId])
  @@index([sprintId])
  @@index([assigneeId])
}

/// Canal de conversa do workspace: público, privado ou mensagem direta.
model Channel {
  id          String      @id @default(cuid())
  workspaceId String
  kind        ChannelKind @default(PUBLIC)
  name        String?
  topic       String?
  /// Projeto opcional ao qual o canal está ligado
  projectId   String?
  createdById String?
  archived    Boolean     @default(false)
  createdAt   DateTime    @default(now())
  updatedAt   DateTime    @updatedAt

  workspace Workspace       @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  members   ChannelMember[]
  messages  Message[]

  @@index([workspaceId])
}

model ChannelMember {
  id         String    @id @default(cuid())
  channelId  String
  userId     String
  isAdmin    Boolean   @default(false)
  lastReadAt DateTime  @default(now())
  mutedAt    DateTime?
  joinedAt   DateTime  @default(now())

  channel Channel @relation(fields: [channelId], references: [id], onDelete: Cascade)
  user    User    @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([channelId, userId])
  @@index([userId])
}

model Message {
  id        String    @id @default(cuid())
  channelId String
  authorId  String
  body      String
  /// Mensagem raiz quando esta é uma resposta em thread
  parentId  String?
  /// Tarefa citada na mensagem (opcional)
  taskId    String?
  editedAt  DateTime?
  createdAt DateTime  @default(now())

  channel   Channel    @relation(fields: [channelId], references: [id], onDelete: Cascade)
  author    User       @relation(fields: [authorId], references: [id], onDelete: Cascade)
  parent    Message?   @relation("Thread", fields: [parentId], references: [id], onDelete: Cascade)
  replies   Message[]  @relation("Thread")
  reactions Reaction[]
  mentions  Mention[]

  @@index([channelId, createdAt])
  @@index([parentId])
}

model Reaction {
  id        String   @id @default(cuid())
  messageId String
  userId    String
  emoji     String
  createdAt DateTime @default(now())

  message Message @relation(fields: [messageId], references: [id], onDelete: Cascade)
  user    User    @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([messageId, userId, emoji])
}

model Mention {
  id        String    @id @default(cuid())
  messageId String
  userId    String
  readAt    DateTime?
  createdAt DateTime  @default(now())

  message Message @relation(fields: [messageId], references: [id], onDelete: Cascade)
  user    User    @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([messageId, userId])
  @@index([userId, readAt])
}

model Tag {
  id          String @id @default(cuid())
  workspaceId String
  name        String
  color       String @default("#eab308")

  workspace Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  tasks     TaskTag[]

  @@unique([workspaceId, name])
}

model TaskTag {
  taskId String
  tagId  String

  task Task @relation(fields: [taskId], references: [id], onDelete: Cascade)
  tag  Tag  @relation(fields: [tagId], references: [id], onDelete: Cascade)

  @@id([taskId, tagId])
}

model Dependency {
  id          String         @id @default(cuid())
  taskId      String
  dependsOnId String
  type        DependencyType @default(FINISH_TO_START)

  task      Task @relation("DependencyTask", fields: [taskId], references: [id], onDelete: Cascade)
  dependsOn Task @relation("DependencyBlocker", fields: [dependsOnId], references: [id], onDelete: Cascade)

  @@unique([taskId, dependsOnId])
}

/// Repositório do GitHub vinculado a um projeto.
model GithubRepo {
  id            String   @id @default(cuid())
  projectId     String
  owner         String
  name          String
  htmlUrl       String
  description   String?
  defaultBranch String   @default("main")
  isPrivate     Boolean  @default(false)
  createdAt     DateTime @default(now())

  project Project          @relation(fields: [projectId], references: [id], onDelete: Cascade)
  links   TaskGithubLink[]

  @@unique([projectId, owner, name])
}

/// Issue ou pull request do GitHub vinculada a uma tarefa.
model TaskGithubLink {
  id       String         @id @default(cuid())
  taskId   String
  repoId   String
  type     GithubLinkType
  number   Int
  title    String
  state    String
  htmlUrl  String
  author   String?
  syncedAt DateTime       @default(now())

  task Task       @relation(fields: [taskId], references: [id], onDelete: Cascade)
  repo GithubRepo @relation(fields: [repoId], references: [id], onDelete: Cascade)

  @@unique([taskId, repoId, number])
  @@index([taskId])
}

/// Pedido de aprovação enviado a um stakeholder por link público.
/// O aprovador não precisa de conta: identifica-se pelo nome ao decidir.
/// E-mail já enviado.
///
/// A chave é o que o e-mail representa (tarefa X vencendo no dia Y), não um
/// identificador novo. É o que impede o resumo diário de mandar duas vezes se
/// o container reiniciar no meio do dia — e sem isso a primeira falha de
/// infraestrutura viraria caixa de entrada duplicada para o time inteiro.
model EmailLog {
  id     String   @id @default(cuid())
  userId String
  kind   String
  key    String
  sentAt DateTime @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, key])
  @@index([sentAt])
}

/// Aviso já lido pela pessoa.
///
/// Menção tem seu próprio `readAt`, mas aprovação decidida e prazo vencido não
/// são registros criados para notificar — são fatos que o painel deduz. Sem um
/// lugar para marcar "já vi isto", eles reapareciam a cada recarga, e o botão
/// "marcar tudo" parecia não fazer nada.
///
/// A chave carrega o que identifica o aviso, incluindo a data do prazo: se a
/// tarefa for reagendada e vencer de novo, é um aviso novo, e deve avisar.
model NotificationRead {
  id     String   @id @default(cuid())
  userId String
  key    String
  readAt DateTime @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, key])
  @@index([userId])
}

/// Documento de anotações do projeto.
///
/// O conteúdo é uma lista de **blocos** em JSON, não HTML. A anotação pode ser
/// publicada por link aberto, e renderizar HTML escrito por usuário numa página
/// pública é convite para injeção de script. Com blocos, o que sai na tela é
/// desenhado pelo nosso próprio código — não há como um documento carregar
/// comportamento junto.
model Note {
  id          String   @id @default(cuid())
  projectId   String
  title       String   @default("Sem título")
  icon        String?
  /// Blocos do documento: [{ id, type, text, … }]
  blocks      Json     @default("[]")
  archived    Boolean  @default(false)
  createdById String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  project     Project      @relation(fields: [projectId], references: [id], onDelete: Cascade)
  createdBy   User?        @relation(fields: [createdById], references: [id], onDelete: SetNull)
  attachments Attachment[]
  share       NoteShare?

  @@index([projectId])
}

/// Link público de uma anotação. Quem tem o link lê; ninguém edita por ali.
model NoteShare {
  id          String    @id @default(cuid())
  noteId      String    @unique
  token       String    @unique
  createdById String?
  expiresAt   DateTime?
  createdAt   DateTime  @default(now())

  note Note @relation(fields: [noteId], references: [id], onDelete: Cascade)
}

/// Cliente OAuth registrado dinamicamente.
///
/// O conector do Claude na web não aceita chave fixa: ele descobre o servidor
/// de autorização, **se registra sozinho** (RFC 7591) e só então manda a pessoa
/// autorizar. Sem esta tabela não há com quem trocar o código por um token.
model OAuthClient {
  id           String   @id @default(cuid())
  clientId     String   @unique
  clientSecret String?
  name         String
  redirectUris String[]
  createdAt    DateTime @default(now())
}

/// Código de autorização — vive segundos, entre o "autorizar" e a troca por
/// token. Guarda o desafio PKCE para que interceptar o código não baste.
model OAuthCode {
  id            String    @id @default(cuid())
  code          String    @unique
  clientId      String
  userId        String
  workspaceId   String
  redirectUri   String
  codeChallenge String
  scope         String?
  expiresAt     DateTime
  usedAt        DateTime?
  createdAt     DateTime  @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([expiresAt])
}

/// Chave de acesso à API do Beni — é o que permite ao MCP (e a qualquer
/// integração) agir em nome de uma pessoa sem usar a senha dela.
///
/// Guardamos só o hash: o valor completo aparece uma única vez, na criação.
/// Se vazar do lado de lá, revoga-se aqui sem trocar senha nenhuma.
model ApiToken {
  id          String    @id @default(cuid())
  workspaceId String
  userId      String
  name        String
  tokenHash   String    @unique
  /// Últimos 4 caracteres, só para a pessoa reconhecer qual é qual na lista.
  hint        String
  lastUsedAt  DateTime?
  revokedAt   DateTime?
  createdAt   DateTime  @default(now())

  workspace Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([workspaceId])
}

/// Arquivo anexado a uma tarefa.
///
/// Por padrão o conteúdo fica aqui mesmo, em `data`: assim o anexo sobrevive a
/// qualquer implantação sem depender de volume montado na plataforma. Para
/// arquivos realmente grandes, definir `UPLOAD_DIR` passa a gravar em disco e
/// só o `storageKey` fica no banco.
model Attachment {
  id           String   @id @default(cuid())
  /// Anexo pertence a uma tarefa, a uma anotação **ou** a um feedback.
  /// A única sobreposição é proposital: quando um feedback vira tarefa, o
  /// print passa a valer para os dois — a triagem continua mostrando a prova
  /// e a tarefa nasce com ela, sem duplicar os bytes.
  taskId       String?
  noteId       String?
  feedbackId   String?
  name         String
  mimeType     String
  size         Int
  /// Conteúdo do arquivo. É o padrão: funciona sem configurar volume nenhum.
  data         Bytes?
  /// Nome em disco, quando UPLOAD_DIR está definido (arquivos grandes).
  storageKey   String?  @unique
  uploadedById String?
  createdAt    DateTime @default(now())

  task       Task?     @relation(fields: [taskId], references: [id], onDelete: Cascade)
  note       Note?     @relation(fields: [noteId], references: [id], onDelete: Cascade)
  feedback   Feedback? @relation(fields: [feedbackId], references: [id], onDelete: Cascade)
  uploadedBy User?     @relation("AttachmentUploader", fields: [uploadedById], references: [id], onDelete: SetNull)

  @@index([taskId])
  @@index([noteId])
  @@index([feedbackId])
}

model Approval {
  id              String         @id @default(cuid())
  taskId          String
  token           String         @unique
  requestedById   String?
  message         String?
  status          ApprovalStatus @default(PENDING)
  approverName    String?
  approverEmail   String?
  approverComment String?
  decidedAt       DateTime?
  expiresAt       DateTime?
  createdAt       DateTime       @default(now())

  task        Task  @relation(fields: [taskId], references: [id], onDelete: Cascade)
  requestedBy User? @relation("ApprovalRequester", fields: [requestedById], references: [id], onDelete: SetNull)

  @@index([taskId])
}

model Comment {
  id         String  @id @default(cuid())
  taskId     String
  authorId   String?
  /// Preenchidos quando o comentário vem de um link público (visitante sem conta)
  guestName  String?
  guestEmail String?
  body       String

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  task   Task  @relation(fields: [taskId], references: [id], onDelete: Cascade)
  author User? @relation(fields: [authorId], references: [id], onDelete: Cascade)

  @@index([taskId])
}

/// Link público de leitura de uma visão do projeto (hoje: o Gantt).
/// Quem tem o link pode ver e, se permitido, comentar nas tarefas.
model ProjectShare {
  id            String    @id @default(cuid())
  projectId     String
  token         String    @unique
  view          String    @default("gantt")
  allowComments Boolean   @default(true)
  createdById   String?
  expiresAt     DateTime?
  createdAt     DateTime  @default(now())

  project   Project @relation(fields: [projectId], references: [id], onDelete: Cascade)
  createdBy User?   @relation("ShareCreator", fields: [createdById], references: [id], onDelete: SetNull)

  @@index([projectId])
}

model Activity {
  id        String   @id @default(cuid())
  projectId String
  taskId    String?
  userId    String?
  action    String
  meta      Json?
  createdAt DateTime @default(now())

  project Project @relation(fields: [projectId], references: [id], onDelete: Cascade)
  task    Task?   @relation(fields: [taskId], references: [id], onDelete: Cascade)
  user    User?   @relation(fields: [userId], references: [id], onDelete: SetNull)

  @@index([projectId, createdAt])
  @@index([taskId])
}

/// Recado de quem usa o Beni para quem faz o Beni.
///
/// Fica fora de `Task` de propósito: cada usuário nasce num workspace só dele,
/// então o recado atravessa a fronteira entre inquilinos. Nas tabelas de
/// trabalho toda leitura é filtrada por workspace — conteúdo que vem de fora
/// não deveria entrar lá antes de alguém olhar. Quando vira tarefa, é por ato
/// explícito de quem tria, e aí nasce no workspace de quem promoveu.
model Feedback {
  id      String         @id @default(cuid())
  kind    FeedbackKind
  status  FeedbackStatus @default(NOVO)
  message String

  /// Contexto capturado sozinho — é o que separa "não funcionou" de algo que
  /// dá para reproduzir.
  pageUrl   String?
  appBuild  String?
  userAgent String?

  /// Autor. O e-mail é copiado em vez de lido pela relação: a conta pode ser
  /// apagada e ainda assim é preciso poder responder a quem escreveu.
  userId      String?
  email       String
  name        String?
  workspaceId String?

  /// Triagem.
  taskId      String?
  adminNote   String?
  /// Última resposta enviada ao autor, para não repetir o mesmo aviso.
  respondedAt DateTime?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  user User? @relation("FeedbackAuthor", fields: [userId], references: [id], onDelete: SetNull)
  task Task? @relation("FeedbackTask", fields: [taskId], references: [id], onDelete: SetNull)

  attachments Attachment[]

  @@index([status, createdAt])
  @@index([userId])
}

/// Token de uso único para recuperar senha e confirmar e-mail.
///
/// Guarda só o hash, como as chaves de API: o valor completo viaja no e-mail
/// e nunca é gravado. Quem ler o banco não consegue entrar na conta de
/// ninguém — no máximo invalidar um pedido.
model AuthToken {
  id        String       @id @default(cuid())
  userId    String
  purpose   TokenPurpose
  tokenHash String       @unique
  expiresAt DateTime
  usedAt    DateTime?
  createdAt DateTime     @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, purpose])
  @@index([expiresAt])
}

/// Foto de perfil.
///
/// Tabela à parte, e não coluna em `User`, por um motivo prático: quase toda
/// consulta traz o usuário inteiro, e bytes de imagem numa coluna do `User`
/// viajariam junto em cada uma delas.
model Avatar {
  userId    String   @id
  mimeType  String
  data      Bytes
  updatedAt DateTime @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
}

/// Um acontecimento de uso, para decidir o que vira plano pago com dado em vez
/// de palpite.
///
/// Guarda o **fato**, nunca o conteúdo: que alguém abriu o Gantt, não o que
/// estava no Gantt. Sem título de tarefa, sem texto de anotação. Isso mantém a
/// tabela leve e evita que uma análise de produto vire um segundo lugar onde
/// o trabalho dos clientes está guardado.
model UsageEvent {
  id          String   @id @default(cuid())
  /// Nome pontuado: "visao.gantt", "tarefa.criar", "link.criar".
  name        String
  userId      String?
  workspaceId String?
  /// Números pequenos de contexto (quantidade). Nada identificável.
  meta        Json?
  /// De onde veio: "app" (o .dmg de macOS), "celular" ou "navegador".
  /// Fica em coluna e não em `meta` porque toda métrica pode ser cortada por
  /// ela — saber que 40% do uso do Gantt vem do app muda decisão de produto.
  origem      String?
  createdAt   DateTime @default(now())

  @@index([name, createdAt])
  @@index([workspaceId, createdAt])
  @@index([userId, createdAt])
  @@index([origem, createdAt])
}

/// ---------------------------------------------------------------------------
/// Cobranças
///
/// Controle de quando cada cliente tem parcela ou mensalidade a vencer. É uma
/// área **privada do dono**, fora do workspace: a carteira de um freelancer não
/// pertence ao time que executa o projeto, e misturar as duas coisas faria
/// qualquer convidado enxergar quanto se cobra de quem.
///
/// Todo valor é **inteiro em centavos**. `Decimal` do Prisma não atravessa a
/// fronteira para componente de cliente sem serializar na mão, e ponto
/// flutuante erra centavo em soma longa. Inteiro não tem nenhum dos dois
/// problemas e a formatação vive num lugar só.
/// ---------------------------------------------------------------------------

model Cliente {
  id         String   @id @default(cuid())
  ownerId    String
  nome       String
  /// E-mail, telefone ou o que sirva para cobrar. Texto livre porque na
  /// prática cada cliente responde por um canal diferente.
  contato    String?
  documento  String?
  observacao String?
  /// Arquivado em vez de apagado: cliente que sumiu ainda tem histórico de
  /// pagamento, e esse histórico é a única memória de quem paga em dia.
  arquivado  Boolean  @default(false)
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  owner     User       @relation(fields: [ownerId], references: [id], onDelete: Cascade)
  cobrancas Cobranca[]

  @@index([ownerId, arquivado])
}

model Cobranca {
  id        String       @id @default(cuid())
  ownerId   String
  clienteId String
  titulo    String
  tipo      CobrancaTipo

  /// A que projeto esta cobrança pertence. **Obrigatório**: cobrança vive
  /// dentro da gestão de um projeto, não numa carteira solta.
  projectId String

  /// Valor de referência, em centavos. O que ele significa depende do tipo:
  /// em `PARCELADO` é o **total** do contrato, em `MENSAL` é o valor **de cada
  /// mês**, em `AVULSO` é o valor único. Fica aqui, e não só nas parcelas,
  /// porque é dele que sai a geração — inclusive das mensalidades futuras, que
  /// ainda não existem como linha.
  valorCentavos Int

  /// Quantas parcelas — só em `PARCELADO`. Mensalidade não tem fim previsto.
  parcelasTotal Int?

  /// Vencimento da primeira parcela. Em `AVULSO` é o vencimento, ponto.
  primeiroVencimento DateTime

  /// Dia do mês do vencimento — só faz sentido em `MENSAL`.
  diaVencimento Int?
  /// Quando a mensalidade parou. Nulo = ainda corrente. Encerrar não apaga as
  /// parcelas passadas, só para de gerar as próximas.
  encerradaEm   DateTime?

  observacao String?
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  owner    User      @relation(fields: [ownerId], references: [id], onDelete: Cascade)
  cliente  Cliente   @relation(fields: [clienteId], references: [id], onDelete: Cascade)
  /// `Restrict`, não `Cascade`: excluir um projeto **não** pode levar junto o
  /// histórico de quem pagou o quê. O banco recusa, e a ação de excluir
  /// projeto explica o motivo antes de chegar aqui.
  project  Project   @relation(fields: [projectId], references: [id], onDelete: Restrict)
  parcelas Parcela[]

  @@index([ownerId])
  @@index([projectId])
  @@index([clienteId])
}

model Parcela {
  id         String @id @default(cuid())
  cobrancaId String
  /// 1, 2, 3… Em mensalidade continua contando indefinidamente.
  numero     Int

  /// Só a data importa; a hora é sempre meia-noite UTC. Ver `lib/cobrancas.ts`:
  /// vencimento com fuso é a origem clássica de "venceu ontem" na virada do dia.
  vencimento    DateTime
  valorCentavos Int
  status        ParcelaStatus @default(PENDENTE)

  /// Quando entrou de fato, e quanto entrou. O valor pago fica separado do
  /// combinado porque desconto e juros existem, e sobrescrever o combinado
  /// apagaria a diferença justamente quando ela interessa.
  pagoEm            DateTime?
  valorPagoCentavos Int?

  observacao String?
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  cobranca Cobranca @relation(fields: [cobrancaId], references: [id], onDelete: Cascade)

  /// Impede parcela duplicada quando a geração da mensalidade roda duas vezes.
  @@unique([cobrancaId, numero])
  @@index([status, vencimento])
}
