# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage

# next.js
/.next/
/out/

# production
/build

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files (can opt-in for committing if needed)
.env*
!.env.example

# vercel
.vercel

# typescript
*.tsbuildinfo
next-env.d.ts

/src/generated/prisma

# cliente do Prisma (gerado por `prisma generate` no postinstall/build)
/src/generated

# app de macOS
/desktop/node_modules
/desktop/dist

# workspace do Maestri
/.maestri

# documentação de skills gerada pelo `prisma init`
/.agents
/.claude
/.windsurf
