# Copie para .env e ajuste
DATABASE_URL="postgresql://beni:beni@localhost:5433/beni?schema=public"

# Segredo usado para assinar o JWT de sessão (troque em produção!)
AUTH_SECRET="troque-esse-segredo-por-uma-string-longa-e-aleatoria"

# Usuário admin criado pelo seed
SEED_ADMIN_EMAIL="admin@beni.app"
SEED_ADMIN_PASSWORD="beni1234"

# Busca com Elasticsearch — OPCIONAL.
# Vazio = busca literal no Postgres (o app funciona igual).
# Aponte para o seu cluster; suba um local com: docker compose --profile search up -d
ELASTICSEARCH_URL=""
ELASTICSEARCH_API_KEY=""
ELASTICSEARCH_USERNAME=""
ELASTICSEARCH_PASSWORD=""
SEARCH_INDEX_PREFIX="beni"
